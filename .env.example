# =============================================================================
# Resto-Pilot Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# Core Settings
# -----------------------------------------------------------------------------
APP_DEBUG=true
APP_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>/<database>?sslmode=require

# -----------------------------------------------------------------------------
# Telegram Bot
# -----------------------------------------------------------------------------
APP_TELEGRAM_BOT_TOKEN=your_bot_token
APP_TELEGRAM_BOT_USERNAME=MyBot
APP_TELEGRAM_WEBHOOK_SECRET_TOKEN=your_webhook_secret
# Comma-separated Telegram user IDs for superuser access (optional)
# APP_TELEGRAM_SUPERUSER_IDS=123456789,987654321

# -----------------------------------------------------------------------------
# Celery Task Queue
# -----------------------------------------------------------------------------
# Option 1: Redis / Upstash
APP_CELERY_BROKER_URL=rediss://default:<password>@<host>:6379

# Option 2: AWS SQS (uncomment and configure)
# APP_CELERY_BROKER_URL=sqs://
# APP_CELERY_SQS_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account-id>/<queue-name>
# APP_CELERY_SQS_REGION=ap-southeast-1
# APP_CELERY_SQS_QUEUE_NAME=celery
# APP_CELERY_SQS_VISIBILITY_TIMEOUT_SECONDS=1800
# APP_CELERY_SQS_WAIT_TIME_SECONDS=10
# APP_AWS_PROFILE=my-aws-profile

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
APP_AUTH_SECRET=change_me_to_a_random_secret

# -----------------------------------------------------------------------------
# LLM Configuration (OpenAI / OpenRouter)
# -----------------------------------------------------------------------------
APP_OPENAI_API_KEY=sk-...
APP_OPENAI_MODEL=gpt-4o-mini
APP_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: separate model for intent classification (cheaper/faster)
# APP_OPENAI_GATE_MODEL=gpt-4o-mini

# OpenRouter (if using OpenRouter instead of OpenAI directly)
# APP_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# APP_OPENAI_MODEL=openai/gpt-4o-mini
# APP_OPENROUTER_HTTP_REFERER=https://your-app.com
# APP_OPENROUTER_TITLE=resto-pilot

# -----------------------------------------------------------------------------
# Vision Model (for file processing - invoices, price lists)
# -----------------------------------------------------------------------------
# If empty, falls back to main OpenAI settings
# APP_VISION_MODEL=gpt-4o-mini
# APP_VISION_API_KEY=
# APP_VISION_BASE_URL=

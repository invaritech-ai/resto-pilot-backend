APP_DEBUG=true
APP_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>/<database>?sslmode=require
APP_CORS_ORIGINS=[]
APP_TELEGRAM_BOT_TOKEN=your_bot_token
APP_TELEGRAM_WEBHOOK_SECRET_TOKEN=your_webhook_secret
APP_TELEGRAM_BATCHING_ENABLED=false
APP_TELEGRAM_BATCH_IDLE_SECONDS=30
APP_TELEGRAM_BATCH_MAX_SECONDS=180

# Optional: prefer a named AWS profile (instead of exporting AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY).
# APP_AWS_PROFILE=resto-pilot

# Redis / Upstash
APP_CELERY_BROKER_URL=rediss://default:<password>@<host>:6379
APP_CELERY_RESULT_BACKEND=

# AWS SQS (Standard queue recommended)
# APP_CELERY_BROKER_URL=sqs://
# APP_CELERY_SQS_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account-id>/<queue-name>
# APP_CELERY_SQS_REGION=ap-southeast-1
# APP_CELERY_SQS_QUEUE_NAME=celery
# APP_CELERY_SQS_VISIBILITY_TIMEOUT_SECONDS=1800
# APP_CELERY_SQS_WAIT_TIME_SECONDS=10
APP_AWS_PROFILE=my-app-profile
APP_AUTH_SECRET=your_app_secret
APP_TELEGRAM_BOT_USERNAME=MyBot

# OpenAI
APP_OPENAI_API_KEY=
# Main model for session replies + structured reasoning (defaults used everywhere else).
APP_OPENAI_MODEL=gpt-5-mini
# Optional: override the fast/cheap models used for:
# - per-message ack/backchannel responses
# - topic gate + chat memory summary
# Leave empty to fall back to APP_OPENAI_MODEL.
APP_OPENAI_ACK_MODEL=openai/gpt-5-nano
APP_OPENAI_GATE_MODEL=openai/gpt-5-nano
APP_OPENAI_BASE_URL=https://api.openai.com/v1
APP_OPENAI_TIMEOUT_SECONDS=120
APP_OPENAI_MAX_RETRIES=2
APP_OPENAI_RETRY_INITIAL_SECONDS=0.5
APP_OPENAI_RETRY_MAX_SECONDS=4
# OpenRouter optional headers (recommended when APP_OPENAI_BASE_URL is OpenRouter)
APP_OPENROUTER_HTTP_REFERER=
APP_OPENROUTER_TITLE=

# Vision (used for invoice/price list/inventory file processing)
# If left empty, falls back to APP_OPENAI_* values.
APP_VISION_MODEL=
APP_VISION_API_KEY=
APP_VISION_BASE_URL=

# Optional: local cost estimation (USD per 1M tokens), keyed by model slug.
# APP_MODEL_PRICES_JSON={"openai/gpt-5-nano":{"input_per_million":0.1,"output_per_million":0.4},"openai/gpt-5.1":{"input_per_million":1.25,"output_per_million":10.0}}

# Main processing bot capability lock-down (comma-separated).
# Examples:
# - inventory
# - db_engine (natural language CRUD with role-based allowlist)
# Enable multiple with commas; leave empty to disable all capabilities.
APP_ENABLED_CAPABILITIES_CSV=inventory,db_engine

# =============================================================================
# Resto-Pilot Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#
# LLM calls are split into three independent groups — each falls back to the
# base APP_OPENAI_* settings if its own key/url/model is not set:
#
#   vision_*  — Stage-1 OCR: image/PDF → clean Markdown text
#   parser_*  — Stage-2 extraction: Markdown → structured JSON (invoices, price lists)
#   chat_*    — Conversational: stock adjustments + natural language queries
#
# Minimal setup: set only APP_OPENAI_* and all three groups share those settings.
# Override individual groups to use separate models or providers.

# -----------------------------------------------------------------------------
# Core Settings
# -----------------------------------------------------------------------------
APP_DEBUG=true
APP_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>/<database>?sslmode=require
APP_AUTH_SECRET=change_me_to_a_random_secret

# -----------------------------------------------------------------------------
# Telegram Bot
# -----------------------------------------------------------------------------
APP_TELEGRAM_BOT_TOKEN=<telegram_bot_token>
APP_TELEGRAM_BOT_USERNAME=MyBot
APP_TELEGRAM_WEBHOOK_SECRET_TOKEN=<telegram_webhook_secret_token>
# Comma-separated Telegram user IDs for superuser access (optional)
# APP_TELEGRAM_SUPERUSER_IDS=123456789,987654321

# -----------------------------------------------------------------------------
# Celery Task Queue
# -----------------------------------------------------------------------------
# Option 1: Redis / Upstash
APP_CELERY_BROKER_URL=rediss://default:<password>@<host>:6379
# APP_CELERY_RESULT_BACKEND=redis://<host>:6379/0

# Option 2: AWS SQS (uncomment and configure)
# APP_CELERY_BROKER_URL=sqs://
# APP_CELERY_SQS_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account-id>/<queue-name>
# APP_CELERY_SQS_REGION=ap-southeast-1
# APP_CELERY_SQS_QUEUE_NAME=celery
# APP_CELERY_SQS_VISIBILITY_TIMEOUT_SECONDS=1800
# APP_CELERY_SQS_WAIT_TIME_SECONDS=10
# APP_AWS_PROFILE=my-aws-profile

# -----------------------------------------------------------------------------
# Base LLM — shared fallback for all three groups below
# -----------------------------------------------------------------------------
# All LLM calls default to these settings unless a group-specific override is set.
# OpenRouter is recommended: single key for 100+ models, per-call cost tracking.
APP_OPENAI_API_KEY=<openrouter_api_key>
APP_OPENAI_BASE_URL=https://openrouter.ai/api/v1
APP_OPENAI_MODEL=openai/gpt-4o-mini

# Optional HTTP tuning
# APP_OPENAI_TIMEOUT_SECONDS=120
# APP_OPENAI_MAX_RETRIES=2

# OpenRouter attribution headers (recommended when using OpenRouter)
# APP_OPENROUTER_HTTP_REFERER=https://your-app.com
# APP_OPENROUTER_TITLE=resto-pilot

# -----------------------------------------------------------------------------
# Vision Model — Stage 1: image/PDF → Markdown OCR
# -----------------------------------------------------------------------------
# Used for: invoice images, price list photos, PDF pages.
# Gemini Flash is fast and cheap for vision; falls back to base model if unset.
APP_VISION_MODEL=google/gemini-2.0-flash
# APP_VISION_API_KEY=    # defaults to APP_OPENAI_API_KEY
# APP_VISION_BASE_URL=   # defaults to APP_OPENAI_BASE_URL

# -----------------------------------------------------------------------------
# Parser Model — Stage 2: Markdown → structured JSON extraction
# -----------------------------------------------------------------------------
# Used for: invoice line-item extraction, price list parsing.
# A fast text model (e.g. gpt-4o-mini) is sufficient; falls back to base model.
# APP_PARSER_MODEL=openai/gpt-4o-mini
# APP_PARSER_API_KEY=    # defaults to APP_OPENAI_API_KEY
# APP_PARSER_BASE_URL=   # defaults to APP_OPENAI_BASE_URL

# -----------------------------------------------------------------------------
# Chat Model — Conversational AI
# -----------------------------------------------------------------------------
# Used for: natural language stock adjustments ("used 2kg chicken") and
#           free-text queries ("show my suppliers", "how many items do I have?").
# Falls back to base model if unset. Can use a cheaper/faster model than parser.
# APP_CHAT_MODEL=openai/gpt-4o-mini
# APP_CHAT_API_KEY=      # defaults to APP_OPENAI_API_KEY
# APP_CHAT_BASE_URL=     # defaults to APP_OPENAI_BASE_URL

# -----------------------------------------------------------------------------
# Side-channel (local/staging testing)
# -----------------------------------------------------------------------------
# Protects /api/v1/sidechannel/message
APP_SIDE_CHANNEL_SECRET_TOKEN=<random_secret>
